"""Unit tests for relaxed_runner module."""

import importlib.util
import subprocess
import sys
from pathlib import Path
from unittest.mock import Mock, patch

import pytest

_LOADER_PATH = Path(__file__).parents[3] / "external_tests" / "credential_loader.py"
_LOADER_SPEC = importlib.util.spec_from_file_location("prp_external_credential_loader_runner", _LOADER_PATH)
assert _LOADER_SPEC is not None and _LOADER_SPEC.loader is not None
_LOADER = importlib.util.module_from_spec(_LOADER_SPEC)
sys.modules["prp_external_credential_loader_runner"] = _LOADER
_LOADER_SPEC.loader.exec_module(_LOADER)

CredentialSet = _LOADER.CredentialSet
parse_credentials_text = _LOADER.parse_credentials_text

_LOGGING_PATH = Path(__file__).parents[3] / "external_tests" / "group_logging.py"
_LOGGING_SPEC = importlib.util.spec_from_file_location("prp_external_group_logging_runner", _LOGGING_PATH)
assert _LOGGING_SPEC is not None and _LOGGING_SPEC.loader is not None
_LOGGING = importlib.util.module_from_spec(_LOGGING_SPEC)
sys.modules["prp_external_group_logging_runner"] = _LOGGING
_LOGGING_SPEC.loader.exec_module(_LOGGING)

GroupLogger = _LOGGING.GroupLogger

_RUNNER_PATH = Path(__file__).parents[3] / "external_tests" / "relaxed_runner.py"
_RUNNER_SPEC = importlib.util.spec_from_file_location("prp_external_relaxed_runner", _RUNNER_PATH)
assert _RUNNER_SPEC is not None and _RUNNER_SPEC.loader is not None
_RUNNER = importlib.util.module_from_spec(_RUNNER_SPEC)
sys.modules["prp_external_relaxed_runner"] = _RUNNER
_RUNNER_SPEC.loader.exec_module(_RUNNER)

GROUP_REGISTRY = _RUNNER.GROUP_REGISTRY
GroupResult = _RUNNER.GroupResult
_build_child_env = _RUNNER._build_child_env
_classify_exit_code = _RUNNER._classify_exit_code
_redact_secrets = _RUNNER._redact_secrets
run_group = _RUNNER.run_group


@pytest.fixture
def dummy_credentials():
    """Create dummy credentials for testing."""
    text = """
## DeepSeek
DEEPSEEK_API_KEY: sk-deepseek-dummy-key-12345678

## Vanyospace OpenAI
OPENAI_API_KEY: sk-openai-dummy-key-87654321

## Vanyospace Anthropic
ANTHROPIC_API_KEY: sk-anthropic-dummy-key-abcdef
"""
    return parse_credentials_text(text)


def test_group_registry_has_all_groups():
    """GROUP_REGISTRY should contain all expected groups."""
    expected_groups = {
        "provider",
        "integration",
        "deep",
        "stability",
        "regression",
        "preflight",
    }
    assert set(GROUP_REGISTRY.keys()) == expected_groups


def test_group_registry_has_valid_specs():
    """All group specs should have required fields."""
    for name, spec in GROUP_REGISTRY.items():
        assert spec.name
        assert spec.pytest_markers
        assert spec.timeout_seconds > 0
        assert spec.description


def test_build_child_env_removes_proxy(dummy_credentials):
    """_build_child_env should remove proxy variables."""
    with patch.dict("os.environ", {
        "http_proxy": "http://proxy.example.com",
        "HTTPS_PROXY": "http://proxy.example.com",
        "no_proxy": "localhost",
    }):
        env = _build_child_env(dummy_credentials)

    assert "http_proxy" not in env
    assert "HTTPS_PROXY" not in env
    assert "no_proxy" not in env


def test_build_child_env_removes_existing_profiles(dummy_credentials):
    """_build_child_env should remove existing PRP_EXTERNAL_ variables."""
    with patch.dict("os.environ", {
        "PRP_EXTERNAL_OLD_API_KEY": "old-key",
        "PRP_EXTERNAL_OLD_MODEL": "old-model",
    }):
        env = _build_child_env(dummy_credentials)

    assert "PRP_EXTERNAL_OLD_API_KEY" not in env
    assert "PRP_EXTERNAL_OLD_MODEL" not in env


def test_build_child_env_adds_all_profiles(dummy_credentials):
    """_build_child_env should add all credential profiles."""
    env = _build_child_env(dummy_credentials)

    # Check at least one profile is present
    assert any(key.startswith("PRP_EXTERNAL_DEEPSEEK") for key in env)
    assert any(key.startswith("PRP_EXTERNAL_LUNA") for key in env)
    assert any(key.startswith("PRP_EXTERNAL_CLAUDE") for key in env)


def test_classify_exit_code_pass():
    """Exit code 0 should classify as PASS."""
    assert _classify_exit_code(0, "", 1.0, 600) == "PASS"


def test_classify_exit_code_timeout():
    """Exit code 124 should classify as UPSTREAM_TRANSIENT."""
    assert _classify_exit_code(124, "", 600.0, 600) == "UPSTREAM_TRANSIENT"


def test_classify_exit_code_no_tests():
    """Exit code 5 should classify as NOT_APPLICABLE."""
    assert _classify_exit_code(5, "", 1.0, 600) == "NOT_APPLICABLE"


def test_classify_exit_code_auth_error():
    """Auth-related stderr should classify as UPSTREAM_AUTH_OR_BALANCE."""
    stderr = "Error: invalid API key authorization failed"
    assert _classify_exit_code(1, stderr, 1.0, 600) == "UPSTREAM_AUTH_OR_BALANCE"


def test_classify_exit_code_connection_error():
    """Connection errors should classify as UPSTREAM_TRANSIENT."""
    stderr = "ConnectionError: timeout connecting to server"
    assert _classify_exit_code(1, stderr, 1.0, 600) == "UPSTREAM_TRANSIENT"


def test_classify_exit_code_unsupported():
    """Unsupported protocol should classify as UPSTREAM_UNSUPPORTED."""
    stderr = "Error: protocol not supported by provider"
    assert _classify_exit_code(1, stderr, 1.0, 600) == "UPSTREAM_UNSUPPORTED"


def test_classify_exit_code_product_defect():
    """Unknown failures should classify as PRODUCT_DEFECT."""
    stderr = "AssertionError: unexpected response format"
    assert _classify_exit_code(1, stderr, 1.0, 600) == "PRODUCT_DEFECT"


def test_redact_secrets_redacts_api_keys(dummy_credentials):
    """_redact_secrets should redact credential values."""
    text = "Using key sk-deepseek-dummy-key-12345678 for request"
    redacted = _redact_secrets(text, dummy_credentials)

    assert "sk-deepseek-dummy-key-12345678" not in redacted
    assert "<REDACTED>" in redacted


def test_redact_secrets_preserves_non_secrets(dummy_credentials):
    """_redact_secrets should preserve non-secret text."""
    text = "Test passed successfully with model deepseek-v4-flash"
    redacted = _redact_secrets(text, dummy_credentials)

    assert "Test passed successfully" in redacted
    assert "deepseek-v4-flash" in redacted


def test_redact_secrets_handles_multiple_keys(dummy_credentials):
    """_redact_secrets should redact all credential types."""
    text = (
        "DeepSeek: sk-deepseek-dummy-key-12345678\n"
        "OpenAI: sk-openai-dummy-key-87654321\n"
        "Anthropic: sk-anthropic-dummy-key-abcdef"
    )
    redacted = _redact_secrets(text, dummy_credentials)

    assert "sk-deepseek-dummy-key-12345678" not in redacted
    assert "sk-openai-dummy-key-87654321" not in redacted
    assert "sk-anthropic-dummy-key-abcdef" not in redacted
    assert redacted.count("<REDACTED>") >= 3


def test_run_group_with_mocked_subprocess(tmp_path, dummy_credentials):
    """run_group should handle successful subprocess execution."""
    logger = GroupLogger(tmp_path, "00-preflight")

    mock_result = Mock()
    mock_result.returncode = 0
    mock_result.stdout = "test_example.py PASSED\n1 passed in 0.5s"
    mock_result.stderr = ""

    with patch("subprocess.run", return_value=mock_result):
        result = run_group("preflight", dummy_credentials, logger)

    assert result.classification == "PASS"
    assert result.exit_code == 0
    assert result.scenarios_passed == 1
    assert result.scenarios_run >= 1


def test_run_group_handles_timeout(tmp_path, dummy_credentials):
    """run_group should handle subprocess timeout."""
    logger = GroupLogger(tmp_path, "00-preflight")

    with patch("subprocess.run", side_effect=subprocess.TimeoutExpired("pytest", 10)):
        result = run_group("preflight", dummy_credentials, logger)

    assert result.classification == "UPSTREAM_TRANSIENT"
    assert result.exit_code == 124


def test_run_group_unknown_group_raises(tmp_path, dummy_credentials):
    """run_group should raise ValueError for unknown group."""
    logger = GroupLogger(tmp_path, "unknown")

    with pytest.raises(ValueError, match="unknown group"):
        run_group("unknown-group", dummy_credentials, logger)


def test_group_result_has_required_fields():
    """GroupResult should accept all required fields."""
    result = GroupResult(
        group="10-provider",
        classification="PASS",
        exit_code=0,
        duration_seconds=5.5,
        scenarios_run=10,
        scenarios_passed=10,
    )

    assert result.group == "10-provider"
    assert result.classification == "PASS"
    assert result.exit_code == 0
    assert result.duration_seconds == 5.5
    assert result.scenarios_run == 10
    assert result.scenarios_passed == 10
